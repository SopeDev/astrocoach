# Pooled PostgreSQL connection used by the application (local PostgreSQL or Neon).
DATABASE_URL=postgresql://astrocoach:astrocoach@localhost:5432/astrocoach

# Optional direct connection for migrations. Recommended when using Neon.
DIRECT_URL=

# Auth.js and Google OAuth
AUTH_SECRET=
AUTH_GOOGLE_ID=
AUTH_GOOGLE_SECRET=

# Server-only OpenAI configuration. Never prefix these values with NEXT_PUBLIC_.
OPENAI_API_KEY=
OPENAI_MODEL=gpt-5.6-luna

# Reserved for the birthplace-search slice.
OPENCAGE_API_KEY=
GEONAMES_USERNAME=

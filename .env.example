# Prisma Postgres connection aliases generated by the Vercel integration.
astro_DATABASE_URL=
astro_POSTGRES_URL=

# Auth.js and Google OAuth
AUTH_SECRET=
AUTH_GOOGLE_ID=
AUTH_GOOGLE_SECRET=

# Server-only OpenAI configuration. Never prefix these values with NEXT_PUBLIC_.
OPENAI_API_KEY=
OPENAI_MODEL=gpt-5.6-luna
OPENAI_TRANSCRIBE_MODEL=gpt-transcribe

# GeoNames account with web services enabled.
GEONAMES_USERNAME=

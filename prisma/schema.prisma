generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

enum Locale {
  en
  es

  @@map("locale")
}

enum Theme {
  system
  light
  dark

  @@map("theme")
}

model User {
  id            String    @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  name          String?   @map("display_name")
  email         String?   @unique
  emailVerified DateTime? @map("email_verified") @db.Timestamptz(6)
  image         String?
  locale        Locale    @default(en)
  theme         Theme     @default(system)
  createdAt     DateTime  @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt     DateTime  @updatedAt @map("updated_at") @db.Timestamptz(6)
  accounts      Account[]
  sessions      Session[]
  birthProfile  BirthProfile?
  natalChart    NatalChart?
  initialIntent InitialIntent?

  @@map("users")
}

model InitialIntent {
  id                 String    @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  userId             String    @unique @map("user_id") @db.Uuid
  lifeAreas          String[]  @map("life_areas")
  currentContext     String?   @map("current_context") @db.Text
  discoveryQuestions Json?     @map("discovery_questions")
  questionsGenerated DateTime? @map("questions_generated_at") @db.Timestamptz(6)
  createdAt          DateTime  @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt          DateTime  @updatedAt @map("updated_at") @db.Timestamptz(6)
  user               User      @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@map("initial_intents")
}

model BirthProfile {
  id                String    @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  userId            String    @unique @map("user_id") @db.Uuid
  birthDate         DateTime  @map("birth_date") @db.Date
  birthTimeMinutes  Int?      @map("birth_time_minutes")
  geonameId         Int?      @map("geoname_id")
  locationName      String?   @map("location_name")
  adminName         String?   @map("admin_name")
  countryName       String?   @map("country_name")
  countryCode       String?   @map("country_code") @db.Char(2)
  latitude          Decimal?  @db.Decimal(9, 6)
  longitude         Decimal?  @db.Decimal(9, 6)
  timezoneId        String?   @map("timezone_id")
  utcOffsetMinutes  Int?      @map("utc_offset_minutes")
  birthInstant      DateTime? @map("birth_instant") @db.Timestamptz(6)
  createdAt         DateTime  @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt         DateTime  @updatedAt @map("updated_at") @db.Timestamptz(6)
  user              User      @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@map("birth_profiles")
}

model NatalChart {
  id                   String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  userId               String   @unique @map("user_id") @db.Uuid
  engine               String
  engineVersion        String   @map("engine_version")
  schemaVersion        Int      @map("schema_version")
  inputHash            String   @map("input_hash")
  timeAccuracy         String   @map("time_accuracy")
  houseSystem          String?  @map("house_system")
  sourceProfileUpdated DateTime @map("source_profile_updated") @db.Timestamptz(6)
  calculatedAt         DateTime @default(now()) @map("calculated_at") @db.Timestamptz(6)
  data                 Json
  createdAt            DateTime @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt            DateTime @updatedAt @map("updated_at") @db.Timestamptz(6)
  user                 User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@map("natal_charts")
}

model Account {
  id                String  @id @default(cuid())
  userId            String  @map("user_id") @db.Uuid
  type              String
  provider          String
  providerAccountId String  @map("provider_account_id")
  refresh_token     String?
  access_token      String?
  expires_at        Int?
  token_type        String?
  scope             String?
  id_token          String?
  session_state     String?
  user              User    @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([provider, providerAccountId])
  @@index([userId])
  @@map("accounts")
}

model Session {
  id           String   @id @default(cuid())
  sessionToken String   @unique @map("session_token")
  userId       String   @map("user_id") @db.Uuid
  expires      DateTime @db.Timestamptz(6)
  user         User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@map("sessions")
}

model VerificationToken {
  identifier String
  token      String
  expires    DateTime @db.Timestamptz(6)

  @@unique([identifier, token])
  @@map("verification_tokens")
}

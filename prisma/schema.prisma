generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

enum Locale {
  en
  es

  @@map("locale")
}

enum Theme {
  system
  light
  dark

  @@map("theme")
}

enum AstrologyFamiliarity {
  new
  basic
  familiar
  advanced

  @@map("astrology_familiarity")
}

enum AstrologyStyle {
  background
  balanced
  explained
  deep

  @@map("astrology_style")
}

enum ConversationMode {
  EXPLORE
  RECOGNIZE

  @@map("conversation_mode")
}

enum ConversationTransitionState {
  IDLE
  OFFERED
  DISMISSED

  @@map("conversation_transition_state")
}

enum ConversationStatus {
  active
  paused
  closed

  @@map("conversation_status")
}

enum MessageRole {
  user
  assistant

  @@map("message_role")
}

model User {
  id                   String               @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  name                 String?              @map("display_name")
  email                String?              @unique
  emailVerified        DateTime?            @map("email_verified") @db.Timestamptz(6)
  image                String?
  locale               Locale               @default(en)
  theme                Theme                @default(system)
  astrologyFamiliarity AstrologyFamiliarity @default(basic) @map("astrology_familiarity")
  astrologyStyle       AstrologyStyle       @default(balanced) @map("astrology_style")
  createdAt            DateTime             @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt            DateTime             @updatedAt @map("updated_at") @db.Timestamptz(6)
  accounts             Account[]
  sessions             Session[]
  birthProfile         BirthProfile?
  natalChart           NatalChart?
  initialIntent        InitialIntent?
  conversations        Conversation[]
  patterns             Pattern[]

  @@map("users")
}

model Conversation {
  id                    String                      @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  userId                String                      @map("user_id") @db.Uuid
  mode                  ConversationMode            @default(EXPLORE)
  status                ConversationStatus          @default(active)
  transitionState       ConversationTransitionState @default(IDLE) @map("transition_state")
  transitionReferenceAt DateTime?                   @map("transition_reference_at") @db.Timestamptz(6)
  title                 String?                     @db.VarChar(120)
  lastMessageAt         DateTime                    @default(now()) @map("last_message_at") @db.Timestamptz(6)
  createdAt             DateTime                    @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt             DateTime                    @updatedAt @map("updated_at") @db.Timestamptz(6)
  user                  User                        @relation(fields: [userId], references: [id], onDelete: Cascade)
  messages              Message[]
  patterns              Pattern[]

  @@index([userId, lastMessageAt(sort: Desc)])
  @@map("conversations")
}

model Message {
  id                String           @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  conversationId    String           @map("conversation_id") @db.Uuid
  role              MessageRole
  mode              ConversationMode @default(EXPLORE)
  content           String           @db.Text
  internalSignals   Json?            @map("internal_signals")
  model             String?
  responseId        String?          @map("response_id")
  inReplyToId       String?          @unique @map("in_reply_to_id") @db.Uuid
  createdAt         DateTime         @default(now()) @map("created_at") @db.Timestamptz(6)
  conversation      Conversation     @relation(fields: [conversationId], references: [id], onDelete: Cascade)
  inReplyTo         Message?         @relation("MessageReply", fields: [inReplyToId], references: [id], onDelete: SetNull)
  reply             Message?         @relation("MessageReply")
  recognizedPattern Pattern?

  @@index([conversationId, createdAt])
  @@map("messages")
}

model Pattern {
  id              String        @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  userId          String        @map("user_id") @db.Uuid
  conversationId  String?       @map("conversation_id") @db.Uuid
  sourceMessageId String?       @unique @map("source_message_id") @db.Uuid
  statement       String        @db.Text
  createdAt       DateTime      @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt       DateTime      @updatedAt @map("updated_at") @db.Timestamptz(6)
  user            User          @relation(fields: [userId], references: [id], onDelete: Cascade)
  conversation    Conversation? @relation(fields: [conversationId], references: [id], onDelete: SetNull)
  sourceMessage   Message?      @relation(fields: [sourceMessageId], references: [id], onDelete: SetNull)

  @@index([userId, createdAt(sort: Desc)])
  @@map("patterns")
}

model InitialIntent {
  id                     String    @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  userId                 String    @unique @map("user_id") @db.Uuid
  lifeAreas              String[]  @map("life_areas")
  currentContext         String?   @map("current_context") @db.Text
  discoveryQuestions     Json?     @map("discovery_questions")
  initialAnswers         Json?     @map("initial_answers")
  finalQuestions         Json?     @map("final_questions")
  finalAnswers           Json?     @map("final_answers")
  questionsGenerated     DateTime? @map("questions_generated_at") @db.Timestamptz(6)
  discoveryCompletedAt   DateTime? @map("discovery_completed_at") @db.Timestamptz(6)
  orientationCompletedAt DateTime? @map("orientation_completed_at") @db.Timestamptz(6)
  createdAt              DateTime  @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt              DateTime  @updatedAt @map("updated_at") @db.Timestamptz(6)
  user                   User      @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@map("initial_intents")
}

model BirthProfile {
  id               String    @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  userId           String    @unique @map("user_id") @db.Uuid
  birthDate        DateTime  @map("birth_date") @db.Date
  birthTimeMinutes Int?      @map("birth_time_minutes")
  geonameId        Int?      @map("geoname_id")
  locationName     String?   @map("location_name")
  adminName        String?   @map("admin_name")
  countryName      String?   @map("country_name")
  countryCode      String?   @map("country_code") @db.Char(2)
  latitude         Decimal?  @db.Decimal(9, 6)
  longitude        Decimal?  @db.Decimal(9, 6)
  timezoneId       String?   @map("timezone_id")
  utcOffsetMinutes Int?      @map("utc_offset_minutes")
  birthInstant     DateTime? @map("birth_instant") @db.Timestamptz(6)
  createdAt        DateTime  @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt        DateTime  @updatedAt @map("updated_at") @db.Timestamptz(6)
  user             User      @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@map("birth_profiles")
}

model NatalChart {
  id                   String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  userId               String   @unique @map("user_id") @db.Uuid
  engine               String
  engineVersion        String   @map("engine_version")
  schemaVersion        Int      @map("schema_version")
  inputHash            String   @map("input_hash")
  timeAccuracy         String   @map("time_accuracy")
  houseSystem          String?  @map("house_system")
  sourceProfileUpdated DateTime @map("source_profile_updated") @db.Timestamptz(6)
  calculatedAt         DateTime @default(now()) @map("calculated_at") @db.Timestamptz(6)
  data                 Json
  createdAt            DateTime @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt            DateTime @updatedAt @map("updated_at") @db.Timestamptz(6)
  user                 User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@map("natal_charts")
}

model Account {
  id                String  @id @default(cuid())
  userId            String  @map("user_id") @db.Uuid
  type              String
  provider          String
  providerAccountId String  @map("provider_account_id")
  refresh_token     String?
  access_token      String?
  expires_at        Int?
  token_type        String?
  scope             String?
  id_token          String?
  session_state     String?
  user              User    @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([provider, providerAccountId])
  @@index([userId])
  @@map("accounts")
}

model Session {
  id           String   @id @default(cuid())
  sessionToken String   @unique @map("session_token")
  userId       String   @map("user_id") @db.Uuid
  expires      DateTime @db.Timestamptz(6)
  user         User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@map("sessions")
}

model VerificationToken {
  identifier String
  token      String
  expires    DateTime @db.Timestamptz(6)

  @@unique([identifier, token])
  @@map("verification_tokens")
}
